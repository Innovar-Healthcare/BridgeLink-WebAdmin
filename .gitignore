# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# deploy logs (generated by scripts/deploy-ec2.sh)
/deploy_log/

# local TLS certs (generated by mkcert or openssl — never commit private keys)
/certs/

# curl/wget session cookies
cookies.txt

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright E2E — generated artifacts and the captured logged-in
# browser state (contains a live session cookie; never commit).
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# next.js
/.next/
/out/

# vendored Monaco editor assets — copied from node_modules by scripts/copy-monaco.mjs
# on every predev/prebuild so the editor loads same-origin, not from the jsdelivr CDN
#. Regenerated each build, like .next/static — not committed.
/public/monaco/

# production
/build

# packaged webadmin artifacts (written by scripts/package-*.sh and CI)
/dist/

# custom server (compiled from server.ts by tsc -p tsconfig.server.json)
/server.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates
# ── Commercial plugin guard ────────────────────────────────────────────────────
# Real plugin implementations live in Innovar-Healthcare/BridgeLink-Commercial-Plugins.
# The core repo has zero awareness of commercial plugin internals — no stubs.
# During local development you may copy or install commercial files via:
#   ./scripts/install-commercial-plugins.sh /path/to/BridgeLink-Commercial-Plugins
# Do NOT commit those files here. The directory ignores below catch any new
# commercial files automatically.
plugins/claude-ai/
plugins/oidc/
plugins/ssl/
plugins/access-control/
plugins/openai/
plugins/anchor/
plugins/siem/
plugins/license-manager/
plugins/_template/
plugins/.github/
plugins/__tests__/
plugins/CLAUDE.md
.git-commercial/
plugins/.git

# Generated plugin loader — produced by scripts/generate-plugin-index.mjs.
# Regenerated automatically by npm run predev / prebuild / pretest / preci.
plugins/index.ts

# Claude Code internal files — session plans, worktrees, local settings
.claude/
.planning/

# Large binary design artifacts — kept locally, not committed to the repo
docs/*.pdf

# Local-only review artifacts (kept out of the repo; other parity docs remain tracked)
docs/-Post-Beta-Release-Summary.md
docs/connector-parity/alerts-code-templates-global-scripts-parity.md
docs/connector-parity/channel-editor-parity.md
docs/connector-parity/events-users-extensions-parity.md
