# ──────────────────────────────────────────────────────────────────────────────
# .dockerignore — keep the build context small and free of local state.
#
# The Dockerfile copies "." into the builder stage, so anything that doesn't
# need to be present at build time should be excluded here. This:
#   - speeds up the COPY step (smaller context)
#   - prevents accidental inclusion of local secrets, .env files, or cached
#     build output that would shadow the in-container build
#   - keeps developer iteration fast when building locally
# ──────────────────────────────────────────────────────────────────────────────

# Git metadata
.git
.git-commercial
.gitignore
.gitattributes

# Node / package managers — node_modules is reinstalled inside the builder
node_modules
.pnp
.pnp.*
.yarn

# Build output — regenerated by `npm run build` inside the container
.next
out
build
dist
server.js
*.tsbuildinfo
next-env.d.ts

# Test artifacts and configs (not needed for production build)
coverage
__tests__
vitest.config.mts
vitest.integration.config.mts
e2e
playwright.config.ts
docker-compose.e2e.yml
docker-compose.ssl-qa.yml
docker-compose.ssl-qa.byo.yml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local secrets, certs, and dev state
.env
.env.*
!.env.example
*.pem
certs
certificates
cookies.txt
deploy_log

# OS / IDE / tool caches
.DS_Store
Thumbs.db
.vscode
.idea
.claude
.cursor
.husky
.planning
.vercel

# CI and repo-tooling configs (not needed at runtime or build)
.github
.editorconfig
.prettierrc
.prettierignore
eslint.config.mjs

# Documentation (not needed at runtime)
*.md
docs
!SUPPLEMENTAL-TERMS.md

# Commercial plugin metadata (sources are copied in via install script, but
# the .git directory inside a commercial checkout is never needed)
plugins/.git
plugins/.github

# Project-specific noise
*.pdf
