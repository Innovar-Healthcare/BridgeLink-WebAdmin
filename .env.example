# BridgeLink Web UI — environment variables
#
# Copy this file to .env.local and fill in values for your environment.
# Never commit .env.local — it is gitignored.

# --- TLS (production only) ---
# Absolute paths to the TLS certificate and private key PEM files for the Web UI.
# When both are set, the custom server starts in HTTPS mode.
# When either is missing, the server falls back to plain HTTP.
# SSL_CERT_FILE=/etc/ssl/certs/bridgelink-webui.crt
# SSL_KEY_FILE=/etc/ssl/private/bridgelink-webui.key
#
# Opt-in CA pinning for the WebAdmin→BridgeLink server hop.
# Set to the absolute path of a PEM file containing the CA (or self-signed
# cert) that signed the BridgeLink server's certificate. When set, full TLS
# verification is enabled for the BL hop. When unset, self-signed certs are
# accepted automatically (backwards-compatible default).
# Do NOT set NODE_TLS_REJECT_UNAUTHORIZED — it is no longer used.
# BRIDGELINK_CA_CERT=/etc/ssl/certs/bridgelink-server-ca.pem

# --- Server port (default: 3000) ---
# PORT=3000

# --- Server access control (SSRF allowlist) ---
# The proxy only relays requests to BridgeLink servers it is configured to
# allow; matching is by exact scheme/host/port (https only). Pick one model:
#
#   Single-server install — login locks to this one server. Also used as the
#   upstream when the client sends no x-bl-server header.
# BRIDGELINK_SERVER_URL=https://your-bridgelink-server:8443
#
#   Multi-server console — login shows a dropdown of these servers.
# BRIDGELINK_ALLOWED_SERVERS=https://bl-a:8443,https://bl-b:8443
#
# With neither set, a build is closed by default: only the same host it is
# served from (https://<hostname>:8443) is allowed.
#
# In sameHost mode, the allowed BridgeLink server is derived from the request
# Host header. Set BRIDGELINK_PUBLIC_HOST to your Web UI's public hostname (or
# host:port) so this derivation is based on a trusted value rather than a
# potentially spoofed header. Recommended when not using an explicit allowlist.
# BRIDGELINK_PUBLIC_HOST=admin.example.com
#
# Dev-only escape hatch: disable the allowlist entirely and keep the free-text
# server field. NEVER set this on a shared or internet-facing deployment.
# (Auto-enabled when NODE_ENV=development, e.g. `npm run dev`.)
# BL_ALLOW_ANY_SERVER=1

# --- Cookie security and HSTS ---
# HSTS (Strict-Transport-Security) and the session cookie Secure flag are set
# automatically based on whether the request is on a secure context. Use these
# to override the auto-detection:
#
# Force secure (e.g. behind an HTTPS load-balancer that strips X-Forwarded-Proto):
# COOKIE_SECURE=true
#
# Force non-secure (intentional plain-HTTP deployment):
# COOKIE_SECURE=false
#
# Disable X-Forwarded-Proto header trust (default: trusted):
# TRUST_PROXY=false

# --- Beta mode ---
# When set to "true", shows a pre-release beta disclaimer at login that users must accept.
# Remove or leave unset for production (GA) deployments.
# BETA_MODE=true

# --- Update check (in-app "a newer WebAdmin is available" notification) ---
# Production deployments need NO configuration: when this is unset and
# NODE_ENV=production, the app checks the Innovar-hosted endpoint automatically.
# Outside production an unset value skips the check entirely.
#
# Point at a different endpoint (e.g. a staging update service):
# VERSION_CHECK_URL=https://staging.example.com/v1/version-check
#
# Turn the check OFF everywhere, production included. Blank, "off", "false" and
# "disabled" all mean off. Use this for test/CI environments that run a
# production build — otherwise each page load sends a real record to the hosted
# deployment-analytics dataset, which skews release-adoption reporting.
# Note: this must be an *explicit* value; simply removing the line falls back to
# the production default described above.
# VERSION_CHECK_URL=off
#
# Do NOT point local development at the live endpoint. Doing so mixes your dev
# traffic into the production analytics dataset.
