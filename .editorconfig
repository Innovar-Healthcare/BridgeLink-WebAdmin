root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# The Windows-native scripts, matching .gitattributes: without this carve-out the
# [*] rule above tells an editorconfig-honouring editor to save them as LF, which is
# the exact silent normalisation the CRLF rules there exist to prevent.
[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
